+async function itemsFromPlaystates(
+  ctx: JellyfinRequestContext,
+  rows: Awaited<ReturnType<typeof JellyfinRepository.listFavorites>>,
+  limit: number
+): Promise<JellyfinItem[]> {
+  return lookup(
+    rows.slice(0, limit),
+    async (row) => {
+      const item = await itemFromDescriptor(ctx, row.payload, {
+        playstate: row,
+      });
+      return item ? [item] : [];
+    },
+    { what: 'item' }
+  );
+}
