+function ticksFrom(
+  body: Record<string, unknown>,
+  req: Request,
+  key: string
+): number | undefined {
+  const v =
+    body[key] ??
+    body[key.charAt(0).toLowerCase() + key.slice(1)] ??
+    qs(req, key);
+  if (v == null || v === '') return undefined;
+  const n = Number(v);
