+        played           INTEGER NOT NULL DEFAULT 0,
+        play_count       INTEGER NOT NULL DEFAULT 0,
+        favorite         INTEGER NOT NULL DEFAULT 0,
+        last_played_at   BIGINT,
+        updated_at       BIGINT NOT NULL DEFAULT 0,
