+    RecursiveItemCount:
+      itemType === 'Series' ? full.videos?.length || undefined : undefined,
+    UserData: playstateToUserData(id, opts.userData, runtimeTicks),
+    Path: `/${meta.type}/${meta.id}`,
+    Container: undefined,
+    MediaSources:
+      itemType === 'Movie'
